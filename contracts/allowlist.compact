pragma language_version >= 0.22;

import CompactStandardLibrary;

export ledger allowlist_root: Bytes<32>;
export ledger nullifiers: Map<Bytes<32>, Boolean>;
export ledger minted_count: Counter;
export ledger admin: Bytes<32>;

constructor(root: Bytes<32>, admin_pk: Bytes<32>) {
  allowlist_root = disclose(root);
  admin = disclose(admin_pk);
  minted_count.increment(0);
}

witness localSecretKey(): Bytes<32>;
witness merkleProof(): Vector<3, Bytes<32>>;
witness merkleDirections(): Vector<3, Boolean>;

export circuit updateRoot(new_root: Bytes<32>): [] {
  assert(disclose(publicKey(localSecretKey())) == admin, "Only admin can update root");
  allowlist_root = disclose(new_root);
}

export circuit claimMintSpot(): [] {
  const sk = localSecretKey();
  const pk = publicKey(sk);

  // Recompute Merkle root and assert it matches on-chain allowlist_root
  const proof = merkleProof();
  const directions = merkleDirections();
  const calculated_root = computeRootDepth3(pk, proof, directions);
  
  assert(disclose(calculated_root) == allowlist_root, "Voter is not in the whitelisted root");

  // Prevent double-claiming
  const nullifier = computeNullifier(sk);
  assert(!nullifiers.member(disclose(nullifier)), "Voter has already claimed their spot");
  
  nullifiers.insert(disclose(nullifier), true);
  minted_count.increment(1);
}

export circuit hashNodes(left: Bytes<32>, right: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([left, right]);
}

export circuit computeRootDepth3(leaf: Bytes<32>, proof: Vector<3, Bytes<32>>, directions: Vector<3, Boolean>): Bytes<32> {
  const hash0 = directions[0] ? hashNodes(leaf, proof[0]) : hashNodes(proof[0], leaf);
  const hash1 = directions[1] ? hashNodes(hash0, proof[1]) : hashNodes(proof[1], hash0);
  const hash2 = directions[2] ? hashNodes(hash1, proof[2]) : hashNodes(proof[2], hash1);
  return hash2;
}

export circuit publicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "allowlist:pk:"), sk]);
}

export circuit computeNullifier(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "allowlist:nullifier:"), sk]);
}
